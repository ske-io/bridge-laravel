#!/usr/bin/env php
<?php

declare(strict_types=1);

use Ske\Bridge\Laravel\Octane\OctaneWorker;
use Ske\Bridge\Laravel\Octane\WorkerServer;

ini_set('display_errors', 'stderr');
$_ENV['APP_RUNNING_IN_CONSOLE'] = false;
$basePath = getcwd();
require $basePath.'/vendor/autoload.php';

if (getenv('SKE_PROVIDER') !== 'aws') {
    throw new RuntimeException('Octane mode is currently supported only on AWS.');
}

$configuredLimit = getenv('SKE_WORKER_MAX_REQUESTS');
$maxRequests = filter_var($configuredLimit === false || $configuredLimit === '' ? '250' : $configuredLimit, FILTER_VALIDATE_INT);

if ($maxRequests === false || $maxRequests < 1) {
    throw new RuntimeException('SKE_WORKER_MAX_REQUESTS must be a positive integer.');
}

(new WorkerServer(
    new OctaneWorker($basePath, $maxRequests),
    getenv('SKE_WORKER_SOCKET') ?: '/tmp/ske-worker.sock',
))->run();
