{
    "name": "ske/laravel-bridge",
    "description": "Runs a Laravel application on SKE: HTTP, queue and console",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/container": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/log": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/framework": "^11.0 || ^12.0 || ^13.0",
        "pestphp/pest": "^4.7",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "files": [
            "bootstrap.php"
        ],
        "psr-4": {
            "Ske\\Bridge\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ske\\Bridge\\Laravel\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "aws/aws-sdk-php": "Required on AWS for the default ske queue connection, which sends jobs to SQS.",
        "inertiajs/inertia-laravel": "Required only for applications opting into Inertia SSR."
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ske\\Bridge\\Laravel\\SkeServiceProvider"
            ]
        }
    }
}
